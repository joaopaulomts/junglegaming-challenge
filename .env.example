# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wallets
DATABASE_SSL=false
DATABASE_POOL_MAX=20

# AWS / SQS (LocalStack)
AWS_REGION=sa-east-1
SQS_ENDPOINT=http://localhost:4566
SQS_REQUEST_QUEUE_URL=http://sqs.sa-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions.fifo
SQS_DLQ_QUEUE_URL=http://sqs.sa-east-1.localhost.localstack.cloud:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://sqs.sa-east-1.localhost.localstack.cloud:4566/000000000000/integration-events.fifo
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_MAX_RECEIVE_COUNT=5
SQS_POLL_INTERVAL_MS=500
SQS_VISIBILITY_TIMEOUT=30

# Inbox
INBOX_CONSUMER_NAME=wager-transaction-consumer

# Outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=20

# Pending-reference worker
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_ATTEMPTS=50
PENDING_REFERENCE.batchLimit=25
